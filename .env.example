APP_NAME=8thLeap Redirect Checker
APP_VERSION=0.1.0
ENVIRONMENT=development

# Use the same MongoDB cluster/database as the existing 8thLeap backend.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/8thleep
MONGODB_DATABASE=8thleep
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

AIWEAVE_BASE_URL=https://aiweave.app

# Redis will be used by Celery in a later step.
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_EXPIRES_SECONDS=3600

REQUEST_TIMEOUT_SECONDS=20
MAX_CONCURRENCY=10
BOT_USER_AGENTS_CSV=OAI-SearchBot,ChatGPT-User,Claude-SearchBot,PerplexityBot
